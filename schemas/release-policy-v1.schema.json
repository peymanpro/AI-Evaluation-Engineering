{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peymanpro/AI-Evaluation-Engineering/blob/main/schemas/release-policy-v1.schema.json",
  "title": "AI Evaluation Engineering Release Policy",
  "description": "Version 1 deterministic, multi-metric release gate policy for recorded AI evaluation runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "policy": {"$ref": "#/$defs/policy"}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence", "resamples", "seed", "metrics"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "resamples": {"type": "integer", "minimum": 100},
        "seed": {"type": "integer"},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/metric"}
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "max_allowed_regression", "min_cases"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["higher_is_better", "lower_is_better"]},
        "max_allowed_regression": {"type": "number", "minimum": 0},
        "min_cases": {"type": "integer", "minimum": 2}
      }
    }
  }
}
